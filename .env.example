# Example values only. Java does not automatically load this file.
# Configure environment variables in Tomcat / IDE before starting the app.
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=Perfume_Website;encrypt=true;trustServerCertificate=true
DB_USERNAME=your_local_sql_server_user
DB_PASSWORD=your_local_sql_server_password

# Optional: email features require valid SMTP credentials.
SMTP_USERNAME=your_smtp_address@example.com
SMTP_PASSWORD=your_smtp_app_password
